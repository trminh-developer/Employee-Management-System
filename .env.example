# ==============================================================================
# TMNexora — Environment Variables Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Django Core Security
DJANGO_SECRET_KEY=change-this-in-production-to-a-very-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tmnexora.local
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://tmnexora.local
DJANGO_LOG_LEVEL=INFO

# Database Configuration (MySQL / MariaDB / SQLite)
# For MySQL in Kubernetes: DB_HOST=mysql-service
# For MySQL on Windows host from Docker: DB_HOST=host.docker.internal
DB_ENGINE=django.db.backends.mysql
DB_NAME=ems
DB_USER=tmnexora_user
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=3306

# WSGI Production Server Configuration (Django Web UI)
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# ASGI RESTful API Server Configuration (FastAPI)
JWT_SECRET_KEY=change-this-in-production-to-a-secure-jwt-secret
API_HOST_PORT=8001
UVICORN_WORKERS=2

# N8N Automation Webhook (Optional)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/send-notification
